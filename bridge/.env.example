# MetaTrader5 credentials (real mode)
MT5_LOGIN=12345678
MT5_PASSWORD=your_investor_password
MT5_SERVER=FTMO-Demo

# 1 = skip MT5 and return a realistic sample DashboardSnapshot
MT5_MOCK=0

# Prop-firm rule set surfaced in the snapshot
RULES_FIRM=FTMO
RULES_PHASE=challenge
RULES_INITIAL_BALANCE=100000
RULES_PROFIT_TARGET_PCT=10
RULES_MAX_DAILY_LOSS_PCT=5
RULES_MAX_TOTAL_LOSS_PCT=10

# FastAPI server port
PORT=8000
